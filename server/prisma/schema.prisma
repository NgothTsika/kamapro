generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Users & Authentication ----------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  role         UserRole @default(USER)

  xp         Int       @default(0)
  streak     Int       @default(0)
  lastActive DateTime?

  language       String?
  offlineEnabled Boolean @default(false)

  // Relations
  completedLessons    CompletedLesson[]
  quizAttempts        QuizAttempt[]
  collectedCharacters CollectedCharacter[]
  userSubmissions     ContentSubmission[]
  contentReports      ContentReport[]      @relation("reporter") // user is reporter
  resolvedReports     ContentReport[]      @relation("resolver") // user as resolver
  offlineContent      OfflineContent[]
  collections         Collection[]
  userAchievements    UserAchievement[]
  pushTokens          PushToken[]
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

// ---------- Content Models ----------
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons    Lesson[]
  characters Character[]
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  content     String // HTML or markdown
  hook        String?
  xpReward    Int      @default(10)
  isPremium   Boolean  @default(false)
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  deepDiveContent String?

  // Self‑relations (many-to-many via junction tables)
  prerequisites   LessonPrerequisite[] @relation("LessonPrerequisites_lesson")
  prerequisiteFor LessonPrerequisite[] @relation("LessonPrerequisites_prerequisite")
  followUps       LessonFollowUp[]     @relation("LessonFollowUps_lesson")
  followUpFor     LessonFollowUp[]     @relation("LessonFollowUps_followUp")

  quizzes          Quiz[]
  translations     LessonTranslation[]
  completedBy      CompletedLesson[]
  reports          ContentReport[]
  offlineContent   OfflineContent[]
  collectionItems  CollectionItem[]
  unlocksCharacter Character?
}

// Many‑to‑many self‑relation junction tables (explicit)
model LessonPrerequisite {
  lessonId       String
  prerequisiteId String

  lesson       Lesson @relation("LessonPrerequisites_lesson", fields: [lessonId], references: [id], onDelete: Cascade)
  prerequisite Lesson @relation("LessonPrerequisites_prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([lessonId, prerequisiteId])
}

model LessonFollowUp {
  lessonId   String
  followUpId String

  lesson   Lesson @relation("LessonFollowUps_lesson", fields: [lessonId], references: [id], onDelete: Cascade)
  followUp Lesson @relation("LessonFollowUps_followUp", fields: [followUpId], references: [id], onDelete: Cascade)

  @@id([lessonId, followUpId])
}

model LessonTranslation {
  id              String   @id @default(cuid())
  language        String
  title           String
  description     String?
  content         String
  hook            String?
  deepDiveContent String?
  createdAt       DateTime @default(now())

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Quiz {
  id            String  @id @default(cuid())
  lessonId      String
  lesson        Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question      String
  options       Json // array of strings
  correctOption Int
  explanation   String?
  order         Int     @default(0)

  attempts QuizAttempt[]
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId         String
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  selectedOption Int
  isCorrect      Boolean
  createdAt      DateTime @default(now())
}

model Character {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  imageUrl    String?
  story       String?
  xpThreshold Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  unlockLessonId String? @unique
  unlockLesson   Lesson? @relation(fields: [unlockLessonId], references: [id], onDelete: SetNull)

  translations CharacterTranslation[]
  collectedBy  CollectedCharacter[]
}

model CharacterTranslation {
  id          String   @id @default(cuid())
  language    String
  name        String
  description String
  story       String?
  createdAt   DateTime @default(now())

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model CompletedLesson {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())
  xpEarned    Int

  @@unique([userId, lessonId])
}

model CollectedCharacter {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  collectedAt DateTime  @default(now())

  @@unique([userId, characterId])
}

// ---------- Community & Missing Features ----------
model ContentSubmission {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // "figure", "invention", "event"
  title          String
  description    String
  content        String?
  imageUrl       String?
  sources        String?
  status         SubmissionStatus @default(PENDING)
  moderatorNotes String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  reports ContentReport[]
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model OfflineContent {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  syncedAt DateTime @default(now())
  lastSync DateTime @updatedAt

  @@unique([userId, lessonId])
}

model ContentReport {
  id           String             @id @default(cuid())
  reporterId   String
  reporter     User               @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  lessonId     String?
  lesson       Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  submissionId String?
  submission   ContentSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  reason       String
  description  String?
  status       ReportStatus       @default(OPEN)
  createdAt    DateTime           @default(now())
  resolvedAt   DateTime?
  resolverId   String?
  resolver     User?              @relation("resolver", fields: [resolverId], references: [id], onDelete: SetNull)
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

// ---------- Additional Missing Features ----------
model Collection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items CollectionItem[]
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order        Int        @default(0)
  addedAt      DateTime   @default(now())

  @@unique([collectionId, lessonId])
}

model Achievement {
  id             String   @id @default(cuid())
  name           String
  description    String
  icon           String?
  xpRequired     Int?
  streakRequired Int?
  createdAt      DateTime @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String // "ios", "android"
  createdAt DateTime @default(now())
}
